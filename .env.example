# Copy to .env and fill. NEVER commit .env (it is gitignored). See docs/security/data-classification.md.

# API
PORT=8080
NODE_ENV=development

# Database (Postgres)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/projectpdfs

# Web (Vite) — same-origin proxy to the API in dev
VITE_API_URL=

# Storage for uploaded PDFs (local dir in dev; object storage in prod)
PDF_STORAGE_DIR=./storage
