# Copy to .env and fill. NEVER commit .env (it is gitignored). See docs/security/data-classification.md.

# API
PORT=8080
NODE_ENV=development

# Database (Postgres)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/projectpdfs

# Web (Vite) — same-origin proxy to the API in dev
VITE_API_URL=

# Storage for uploaded PDFs (local dir in dev; object storage in prod)
PDF_STORAGE_DIR=./storage

# --- Windows code signing (Tauri build) — see docs/reference/code-signing.md ---
# Set ONE of: a cert thumbprint from the Windows store, OR a .pfx path (+ password).
# Leave all blank for unsigned dev builds. These are secrets — keep them in .env only.
WINDOWS_CERT_THUMBPRINT=
WINDOWS_CERT_PFX=
WINDOWS_CERT_PASSWORD=
# RFC-3161 timestamp server (default DigiCert if unset).
WINDOWS_TS_URL=http://timestamp.digicert.com
