{
  "manifest_version": 3,
  "name": "PolyglotFormFill Autofill (companion)",
  "version": "0.1.0",
  "description": "Privacy-first form autofill. Encrypted vault unlocked by passphrase or passkey (WebAuthn). No data leaves your device.",
  "permissions": ["storage", "activeTab", "scripting", "nativeMessaging"],
  "host_permissions": ["https://polyglotformfill.surge.sh/*"],
  "background": { "service_worker": "src/background.js", "type": "module" },
  "action": {
    "default_popup": "popup.html",
    "default_title": "PolyglotFormFill Autofill",
    "default_icon": { "16": "icon16.png", "48": "icon48.png", "128": "icon128.png" }
  },
  "options_page": "options.html",
  "icons": { "16": "icon16.png", "48": "icon48.png", "128": "icon128.png" },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; connect-src 'self' https://polyglotformfill.surge.sh https://objectstorage.us-ashburn-1.oraclecloud.com"
  }
}
