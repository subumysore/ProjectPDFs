{
  "name": "projectpdfs",
  "version": "1.0.18",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "check:traceability": "node scripts/check-traceability.mjs"
  },
  "devDependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "puppeteer-core": "^25.4.0",
    "typescript": "^5.6.0"
  },
  "pnpm": {
    "overrides": {
      "onnxruntime-node": "file:./stubs/onnxruntime-node",
      "sharp": "file:./stubs/sharp",
      "@napi-rs/canvas": "file:./stubs/napi-canvas"
    },
    "patchedDependencies": {
      "@pdf-lib/fontkit": "patches/@pdf-lib__fontkit.patch"
    }
  }
}
