# Caddy serves the static site AND auto-provisions HTTPS (Let's Encrypt).
# Requires: DNS polyglotformfill.mooo.com -> this VM's public IP, and ports 80+443
# open in BOTH the Oracle Security List and the VM's OS firewall.
polyglotformfill.mooo.com {
	root * /var/www/polyglotformfill
	file_server
	encode gzip
	# Nice URLs: /privacy -> /privacy/index.html is handled by file_server automatically.
}
