# Dependencies
node_modules/
.pnp.*
vendor/
__pycache__/
*.egg-info/
.venv/
venv/

# Build output
dist/
build/
out/
target/
*.tsbuildinfo

# Env & secrets — NEVER commit
.env
.env.*
!.env.example
*.pem
*.key
secrets/
*.secret

# Test / coverage
coverage/
.nyc_output/
playwright-report/
test-results/

# Large artifacts (keep the repo lean; use releases/artifact storage instead)
*.zip
*.tar.gz
*.mp4

# Editor / OS
.DS_Store
Thumbs.db
.idea/
*.swp

# Agent/local caches
.cache/
scratchpad/

# Google Drive sync artifacts (the whole folder is Drive-synced)
.tmp.driveupload/
.tmp.drivedownload/
*.tmp.drive*

# Self-hosted OCR/ML model assets (large; reproduced by scripts/fetch-ocr-assets.mjs
# and scripts/fetch-translation-assets.mjs). Present on disk for local testing.
apps/app/public/tesseract/
apps/app/public/models/
apps/app/public/ort/

# Code-signing certificates — NEVER commit
*.pfx
*.p12
*.cer
*.crt
*.key

# Extension package output
apps/extension/dist/
apps/extension/.chrome-ext-*/
scripts/license/vendor-key.json
apps/extension/vendor/transformers/*.wasm
docs/marketing/site/pitch/PolyglotFormFill-pitch.mp4
docs/marketing/site/pitch/shots/
