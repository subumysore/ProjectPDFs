# Editor / OS
.DS_Store
Thumbs.db
.idea/
*.swp

# Agent/local caches
.cache/
scratchpad/

# Google Drive sync artifacts (the whole folder is Drive-synced)
.tmp.driveupload/
.tmp.drivedownload/
*.tmp.drive*
